{
  "name": "json-canopy",
  "displayName": "JSON Canopy",
  "description": "Browse and edit JSON files as tables and forms, with JSON Schema support.",
  "version": "0.0.1",
  "publisher": "sonensei",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "jsonCanopy.editor",
        "displayName": "JSON Canopy",
        "selector": [
          {
            "filenamePattern": "*.json"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "scripts": {
    "build:webapp": "npm --prefix .. run build",
    "copy:webview": "node scripts/copy-webview.mjs",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --sourcemap",
    "build": "npm run build:webapp && npm run copy:webview && npm run bundle",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.100.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  }
}
